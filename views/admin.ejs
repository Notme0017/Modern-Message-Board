<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title><%=title%></title>
</head>
<body>
  <%-include("partials/nav")%>

  <h2><%=title%></h2>
  <%-include("partials/errors")%>

  <form method="post" action="/admin" class="admin-form">
    <p>Enter passcode to become an admin. You can delete messages.</p>
    <label for="passcode">Passcode</label>
    <input id="passcode" type="password" name="passcode" />

    <button type="submit">Become Admin</button>
  </form>
</body>
</html>