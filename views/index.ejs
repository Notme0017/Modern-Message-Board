<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title><%=title%></title>
</head>
<body>
  <%-include("partials/nav") %>
  <h1><%=title%></h1>

  <ul class="message-list">
    <% messages.forEach((message) =>{ %>
      <li class="message">
        <div class="message-title"><%=message.title%></div>
        <div class="message-text"><%=message.message%></div>

        <div class="message-footer">
          <% if(locals.user){ %>
            <%if(user.admin) {%>
              <form class="delete-message" action="/message/<%=message.message_id%>/delete" method="post">
                <button type="submit" onclick="return confirm('Are you sure you want to delete this message?')">Delete</button>
              </form>
            <%}%>

            <% if(user.membership) {%>
              <div class="message-meta">
                <div class="user-name"><%=message.username%></div>
                <div class="time"><%=message.time.toLocaleDateString()%></div>
              </div>
            <%}%>
          <%}%>
        </div>
      </li>
    <% }) %>
  </ul>
</body>
</html>