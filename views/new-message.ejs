<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css">
  <title><%=title%></title>
</head>
<body>
  <%-include("partials/nav") %>

  <h2><%=title%></h2>
  <%-include("partials/errors") %>

  <form action="/message/new" method="post" class="new-message-form">
    <label for="messagetitle">Title</label>
    <input id="messagetitle" value="<%=locals.messagetitle || ''%>" name="messagetitle" />

    <label for="message">Message</label>
    <textarea name="message" id="message"><%=locals.message || ''%></textarea>

    <button type="submit">Post</button>
  </form>
</body>
</html>